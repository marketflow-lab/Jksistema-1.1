{
  "name": "jk-sistema-desktop",
  "version": "1.0.147",
  "description": "Cliente desktop para JK Sistema",
  "main": "main.js",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.13.0",
    "npm": "11.6.2"
  },
  "scripts": {
    "prestart": "npm run verify:deps && npm run prepare:runtime && npm run verify:package",
    "start": "electron .",
    "verify:deps": "node ../scripts/verify-dependency-locks.js",
    "prepare:runtime": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/prepare_installer_runtime.ps1",
    "verify:runtime-contract": "node scripts/verify-runtime-contract.js",
    "verify:package": "node scripts/verify-installer-package.js",
    "verify:package:built": "node scripts/verify-installer-package.js --packaged dist-client-setup/win-unpacked/resources",
    "verify:update": "node scripts/verify-update-package.js",
    "verify:update:built": "node scripts/verify-update-package.js --packaged dist-client-update/win-unpacked/resources",
    "predist": "npm run verify:deps && npm run prepare:runtime && npm run verify:package",
    "dist": "electron-builder",
    "postdist": "npm run verify:package:built",
    "predist:full": "npm run verify:deps && npm run verify:runtime-contract && npm run prepare:runtime && npm run verify:package",
    "dist:full": "node scripts/build-installer-profile.js full",
    "postdist:full": "npm run verify:package:built",
    "predist:update": "npm run verify:deps && npm run verify:runtime-contract && npm run verify:update",
    "dist:update": "node scripts/build-installer-profile.js update",
    "postdist:update": "npm run verify:update:built",
    "dist:publish": "node scripts/direct-publish-disabled.js"
  },
  "author": "JK",
  "license": "ISC",
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "24.13.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "build": {
    "directories": {
      "output": "dist-client-setup"
    },
    "appId": "com.jksistema.cliente",
    "productName": "JK Sistema Cliente",
    "asar": true,
    "afterPack": "scripts/after-pack-local-app-manifest.js",
    "publish": [
      {
        "provider": "github",
        "owner": "marketflow-lab",
        "repo": "Jksistema-1.1",
        "releaseType": "release"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "client-config.json",
      "CONFIGURAR_SERVIDOR.md"
    ],
    "extraResources": [
      {
        "from": "../electron_shell.html",
        "to": "electron_shell.html"
      },
      {
        "from": "../electron_tab_preload.js",
        "to": "electron_tab_preload.js"
      },
      {
        "from": "../extensoes_chrome",
        "to": "extensoes_chrome"
      },
      {
        "from": "../",
        "to": "local_app",
        "filter": [
          "package.json",
          "*.py",
          "backend/**",
          "vendor/**",
          "!backend/**/__pycache__/**",
          "!backend/**/*.pyc",
          "!backend/**/*.pyo",
          "requirements.txt",
          "runtime-versions.json",
          "installer-runtime.lock.json",
          "scripts/provision_python_runtime.py",
          "scripts/repair_legacy_tenant_root.py",
          "*.html",
          "*.js",
          "electron_app/main/modules/**",
          "ml_questions_gemini/**",
          "!ml_questions_gemini/**/__pycache__/**",
          "!ml_questions_gemini/**/*.pyc",
          "!ml_questions_gemini/**/*.pyo",
          "firebase-presence.env",
          "context-bundle-manifest.json",
          "docs/knowledge/**",
          "static/**",
          "img/**",
          "python_runtime/**",
          "!python_runtime/**/__pycache__/**",
          "!python_runtime/**/*.pyc",
          "!python_runtime/**/*.pyo",
          "python_wheels/**",
          "!info/**",
          "!logs/**",
          "!backups/**",
          "!ContextVault/**",
          "!context_hub/**",
          "!.obsidian/**",
          "!SKU/**",
          "NCM.xlsx",
          "NCM1.xlsx",
          "openapi_bling.json"
        ]
      },
      {
        "from": "../.installer_runtime/black_jhon",
        "to": "local_app/black_jhon_runtime"
      },
      {
        "from": "../.installer_runtime/prerequisites",
        "to": "local_app/prerequisites"
      },
      {
        "from": "../.installer_runtime/runtime-manifest.json",
        "to": "local_app/runtime-manifest.json"
      },
      {
        "from": "client-config.json",
        "to": "client-config.json"
      },
      {
        "from": "CONFIGURAR_SERVIDOR.md",
        "to": "CONFIGURAR_SERVIDOR.md"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "artifactName": "JK-Sistema-Cliente-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JK Sistema Cliente"
    }
  }
}
