{
  "name": "jk-sistema-desktop",
  "version": "1.0.98",
  "description": "Cliente desktop para JK Sistema",
  "main": "main.js",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.13.0",
    "npm": "11.6.2"
  },
  "scripts": {
    "prestart": "npm run verify:deps && npm run prepare:runtime && npm run verify:package",
    "start": "electron .",
    "verify:deps": "node ../scripts/verify-dependency-locks.js",
    "prepare:runtime": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/prepare_installer_runtime.ps1",
    "verify:package": "node scripts/verify-installer-package.js",
    "verify:package:built": "node scripts/verify-installer-package.js --packaged dist-client-setup/win-unpacked/resources",
    "predist": "npm run verify:deps && npm run prepare:runtime && npm run verify:package",
    "dist": "electron-builder",
    "postdist": "npm run verify:package:built",
    "predist:publish": "npm run verify:deps && npm run prepare:runtime && npm run verify:package",
    "postdist:publish": "npm run verify:package:built",
    "dist:publish": "electron-builder --publish always"
  },
  "author": "JK",
  "license": "ISC",
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "24.13.3"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "build": {
    "directories": {
      "output": "dist-client-setup"
    },
    "appId": "com.jksistema.cliente",
    "productName": "JK Sistema Cliente",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "marketflow-lab",
        "repo": "Jksistema-1.1",
        "releaseType": "release"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "client-config.json",
      "CONFIGURAR_SERVIDOR.md"
    ],
    "extraResources": [
      {
        "from": "../electron_shell.html",
        "to": "electron_shell.html"
      },
      {
        "from": "../electron_tab_preload.js",
        "to": "electron_tab_preload.js"
      },
      {
        "from": "../extensoes_chrome",
        "to": "extensoes_chrome"
      },
      {
        "from": "../",
        "to": "local_app",
        "filter": [
          "*.py",
          "backend/**",
          "!backend/**/__pycache__/**",
          "!backend/**/*.pyc",
          "requirements.txt",
          "*.html",
          "*.js",
          "electron_app/main/modules/**",
          "ml_questions_gemini/**",
          "!ml_questions_gemini/**/__pycache__/**",
          "!ml_questions_gemini/**/*.pyc",
          "firebase-presence.env",
          "jkjkjk-*.json",
          "firebase-service-account.json",
          "firebase_service_account.json",
          "*service-account*.json",
          "static/**",
          "img/**",
          "python_runtime/**",
          "python_wheels/**",
          "NCM.xlsx",
          "NCM1.xlsx",
          "openapi_bling.json"
        ]
      },
      {
        "from": "../.installer_runtime/black_jhon",
        "to": "local_app/black_jhon_runtime"
      },
      {
        "from": "../.installer_runtime/prerequisites",
        "to": "local_app/prerequisites"
      },
      {
        "from": "../.installer_runtime/runtime-manifest.json",
        "to": "local_app/runtime-manifest.json"
      },
      {
        "from": "client-config.json",
        "to": "client-config.json"
      },
      {
        "from": "CONFIGURAR_SERVIDOR.md",
        "to": "CONFIGURAR_SERVIDOR.md"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "artifactName": "JK-Sistema-Cliente-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JK Sistema Cliente"
    }
  }
}
