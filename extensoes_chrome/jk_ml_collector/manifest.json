{
  "manifest_version": 3,
  "name": "JK ML Collector Local",
  "version": "0.7.0",
  "description": "Coletor local do JK Sistema para dados de anuncios do Mercado Livre.",
  "host_permissions": [
    "http://*.mercadolivre.com.br/*",
    "https://*.mercadolivre.com.br/*",
    "http://*.mercadolibre.com/*",
    "https://*.mercadolibre.com/*",
    "https://api.mercadolibre.com/*",
    "http://127.0.0.1:8001/*",
    "http://localhost:8001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*.mercadolivre.com.br/*",
        "https://*.mercadolivre.com.br/*",
        "http://*.mercadolibre.com/*",
        "https://*.mercadolibre.com/*"
      ],
      "js": [
        "page-collector.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*.mercadolivre.com.br/*",
        "https://*.mercadolivre.com.br/*",
        "http://*.mercadolibre.com/*",
        "https://*.mercadolibre.com/*"
      ],
      "js": [
        "enricher.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ]
}
