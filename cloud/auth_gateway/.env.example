FIREBASE_PROJECT_ID=jkjkjk-485920
FIREBASE_WEB_API_KEY=replace-with-the-restricted-public-web-key
FIREBASE_USERS_COLLECTION=jk_sistema_usuarios
JK_AUTH_MIN_APP_VERSION=1.0.124
JK_AUTH_RATE_LIMIT_ATTEMPTS=10
JK_AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# Public OAuth audience already used by the JK Google sign-in.
GOOGLE_LOGIN_CLIENT_ID=
# Server-only refresh signing secrets: 32 random bytes encoded as 64 hex digits.
# Inject fixed Secret Manager versions in Cloud Run; never package real values.
JK_COFRE_SESSION_SECRET=
# During rotation, retain the preceding key for the maximum 30-day lease.
JK_COFRE_SESSION_PREVIOUS_SECRET=
JK_CENTRAL_ENABLED=0
JK_CENTRAL_REQUIRE_ENROLLMENT=1
# When enabled, inject JK_CENTRAL_VAULT_KEY through a fixed Secret Manager version.
# Set JK_CENTRAL_PUBLIC_ORIGIN to the HTTPS origin that serves /api/central/**.
