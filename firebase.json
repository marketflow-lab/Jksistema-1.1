{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "firebase_hosting_public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/auth/callback",
        "destination": "/oauth-bridge.html"
      },
      {
        "source": "/auth/google/callback",
        "destination": "/oauth-bridge.html"
      }
    ],
    "headers": [
      {
        "source": "/oauth-bridge.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate"
          }
        ]
      }
    ]
  }
}
