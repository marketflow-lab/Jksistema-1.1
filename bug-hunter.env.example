# Safety defaults. Keep dry-run enabled unless a human explicitly approves otherwise.
BUG_HUNTER_DRY_RUN=true
MELI_SANDBOX=false
BUG_HUNTER_ALLOW_MUTATIONS=false

# Strongly recommended for targeted safe checks.
BUG_HUNTER_STORE=
