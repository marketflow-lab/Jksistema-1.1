{
  "name": "jk-sistema-desktop",
  "version": "1.0.110",
  "description": "Cliente desktop para JK Sistema",
  "main": "main.js",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.13.0",
    "npm": "11.6.2"
  },
  "scripts": {
    "deps:verify": "node scripts/verify-dependency-locks.js",
    "deps:python:lock": "python scripts/lock_python_dependencies.py",
    "deps:python:test-lock": "python scripts/lock_python_dependencies.py --input requirements-test.in --output requirements-test.txt --cache-dir .dependency-lock-test",
    "test": "npm run test:full",
    "test:full": "node scripts/run-full-test-suite.js",
    "test:inventory": "node scripts/test-inventory.js",
    "test:node": "node scripts/run-node-regressions.js",
    "test:probes:syntax": "node scripts/verify-diagnostic-probes.js",
    "test:gateway": "npm --prefix cloudflare/whatsapp-gateway test",
    "test:gateway:check": "npm --prefix cloudflare/whatsapp-gateway run check",
    "test:bug-hunter:contract": "playwright test --config=playwright.bug-hunter.config.js",
    "test:python": "node scripts/run-python-tests.js",
    "test:python:coverage": "node scripts/run-python-tests.js --coverage",
    "bug-hunter": "playwright test --config=playwright.bug-hunter.config.js",
    "bug-hunter:headed": "playwright test --config=playwright.bug-hunter.config.js --headed",
    "bug-hunter:install": "playwright install chromium",
    "bug-hunter:report": "playwright show-report bug-hunter-report/playwright-html"
  },
  "author": "JK",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "electron": "28.3.3"
  }
}
